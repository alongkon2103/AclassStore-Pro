{
  "name": "aclass-live",
  "version": "1.0.0",
  "main": "electron/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alongkon2103/AclassStore-Pro.git"
  },
  "scripts": {
    "vite:dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "NODE_ENV=development electron .",
    "dev": "concurrently \"npm run vite:dev\" \"wait-on http://127.0.0.1:5173 && npm run electron:dev\"",
    "electron:build": "npm run build && electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "electron": "^41.6.1",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-store": "^11.0.2",
    "lucide-react": "^1.16.0",
    "node-fetch": "^2.7.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "tiktok-live-connector": "^2.1.1-beta1",
    "uuid": "^14.0.0"
  },
  "build": {
    "appId": "com.aclass.live",
    "productName": "AclassLive",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "AclassStoreLive.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "alongkon2103",
        "repo": "AclassStore-Pro"
      }
    ]
  }
}